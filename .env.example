# URL du backend utilisée par le proxy Vite (optionnel).
# Laissez vide pour utiliser le proxy /api intégré de Vite.
VITE_BACKEND_URL=http://localhost:8000

# URL absolue de l'API. À laisser vide en développement
# (le proxy Vite suffit). En production, served depuis un autre domaine.
# VITE_API_URL=https://api.exemple.mg
